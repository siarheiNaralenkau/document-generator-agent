# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Session (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_session_secret_here

# Server
NODE_ENV=production
PORT=3000
BASE_URL=http://localhost:3000

# BYOK (optional): when both are set, GitHub login is skipped and Copilot uses your model provider key.
MODEL_URL=https://api.openai.com/v1
MODEL_API_KEY=your-model-api-key
# Optional: openai | azure | anthropic (default: openai)
# MODEL_PROVIDER=openai
# Optional: completions | responses — use responses for GPT-5–style endpoints (default: completions)
# MODEL_WIRE_API=completions

# Optional GitHub Enterprise / custom API hosts (defaults: github.com / api.github.com)
# GITHUB_OAUTH_BASE_URL=https://github.com
# GITHUB_API_BASE_URL=https://api.github.com

# Optional CORS origin for /api (defaults to BASE_URL)
# FRONTEND_URL=http://localhost:3000

# Optional session cookie Secure flag (auto from BASE_URL scheme if unset)
# SESSION_COOKIE_SECURE=false

# Optional Copilot model override
# COPILOT_MODEL=claude-haiku-4.5
