FROM node:20-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend package files
COPY backend/package*.json ./
RUN npm ci

# Copy backend code
COPY backend/ .

# Build TypeScript
RUN npm run build

# Create directories
RUN mkdir -p /app/sessions

EXPOSE 3001

CMD ["node", "dist/main.js"]
