# Backend environment variables (development)
#
# When running backend locally:
#   cd backend
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
#   npm run dev

# GitHub OAuth credentials
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# GitHub OAuth/API base URLs (defaults work for github.com)
# For GitHub Enterprise / custom domains, override these, e.g.:
#   GITHUB_OAUTH_BASE_URL=https://github.tools.sap
#   GITHUB_API_BASE_URL=https://github.tools.sap/api/v3
GITHUB_OAUTH_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com

# Session
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Server configuration
NODE_ENV=development
PORT=3001

# Listed repositories and URL clones live under ~/.copilot-sdk-demo/repos (not configurable).

# Frontend origin (CORS) and OAuth redirect base
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Optional override for session cookie `Secure` flag.
# Leave unset for auto mode (true for https BASE_URL, false for http localhost).
# SESSION_COOKIE_SECURE=false

