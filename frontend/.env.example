# Frontend dev config
#
# Next.js uses these env vars at build/dev-server time.
# - `BACKEND_URL` is used by `next.config.js` rewrite that proxies `/api/*` to the backend.
# - `NEXT_PUBLIC_API_URL` is an optional fallback; use it if you also reference it in client code.

# Local backend
BACKEND_URL=http://localhost:3001

# Alternative (Docker Compose service name)
# BACKEND_URL=http://backend:3001

# Optional fallback (not required if BACKEND_URL is set)
NEXT_PUBLIC_API_URL=http://localhost:3001

